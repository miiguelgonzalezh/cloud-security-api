{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/.env)",
      "Read(./**/.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/credentials.json)",
      "Read(./**/secrets.json)",
      "Bash(cat *.env*)",
      "Bash(cat .env*)",
      "Bash(type *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(more *.env*)",
      "Bash(less *.env*)",
      "Bash(grep * .env*)",
      "Bash(Get-Content *.env*)"
    ]
  },
  "sandbox": {
    "filesystem": {
      "denyRead": [
        ".env",
        ".env.*",
        "**/.env",
        "**/.env.*"
      ]
    }
  }
}
