# Secretos locales (el .gitignore raiz tambien los cubre)
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
.pytest_cache/

# Salidas generadas
output/raw/
output/reports/*
!output/reports/.gitkeep

# CA corporativas: especificas de cada red, se regeneran (ver certs/README.md)
certs/*.crt
