# ---------------------------------------------------------------------------
# Credenciales Falcon (una API client por cliente, scope de solo lectura).
# Scopes minimos requeridos por esta fase:
#   Cloud security detections: READ
# ---------------------------------------------------------------------------
FALCON_CLIENT_ID=
FALCON_CLIENT_SECRET=

# Region del tenant: us-1 | us-2 | us-3 | eu-1 | us-gov-1 | us-gov-2
FALCON_CLOUD=us-1

# ---------------------------------------------------------------------------
# Identidad del reporte
# ---------------------------------------------------------------------------
CLIENT_NAME=Cliente Demo
# daily | weekly | monthly  (solo afecta el texto del periodo y el cron)
REPORT_FREQUENCY=weekly

# ---------------------------------------------------------------------------
# Salida y retencion
# ---------------------------------------------------------------------------
OUTPUT_DIR=output/reports
# Cuantos reportes historicos se conservan por cliente (0 = sin limite)
REPORT_RETENTION=12

# ---------------------------------------------------------------------------
# Comportamiento de red / reintentos
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
REQUEST_TIMEOUT=60
MAX_RETRIES=3
BACKOFF_BASE=1.0
BACKOFF_CAP=30.0

# ---------------------------------------------------------------------------
# Cloud Risks (IOMs agrupados por regla)
# FQL; vaciar para traer todas las severidades.
# Campos soportados: severity, cloud_provider, account_id, region, service,
# framework, status, resource_type, ... (ver docs del endpoint)
# ---------------------------------------------------------------------------
CLOUD_RISKS_FILTER=severity:['High','Critical']
# Opcional: assessed_assets|desc, misconfigurations|desc, severity|asc, rule_id|asc
CLOUD_RISKS_SORT=
# Tope defensivo de registros por fetcher (0 = sin tope)
MAX_RECORDS_PER_FETCHER=0

# CDN de Chart.js embebido en el HTML generado.
CHARTJS_URL=https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js
