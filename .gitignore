.venv/
venv/
env/
ENV/
.virtualenv/
pip-wheel-metadata/
site-packages/

# Bytecode y cache
__pycache__/
*.py[cod]
*$py.class
*.so

# Build / distribucion
build/
dist/
*.egg-info/
.eggs/
wheels/

# Herramientas y cache de tests
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/

